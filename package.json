{
  "name": "sb-stream-tool",
  "description": "Stream tool for Super Smash Bros tournaments built in Electron + Vite + React",
  "version": "0.0.4",
  "private": true,
  "type": "module",
  "author": {
    "email": "grok1618@gmail.com",
    "name": "grokzero0",
    "url": "https://www.domocup.xyz"
  },
  "main": "packages/entry-point.mjs",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=23.0.0"
  },
  "scripts": {
    "build": "npm run build -ws --if-present",
    "publish": "electron-builder --publish onTagOrDraft --config electron-builder.mjs",
    "compile": "npm run build && electron-builder build --config electron-builder.mjs",
    "test": "npx playwright test ./tests/e2e.spec.ts",
    "start": "node packages/dev-mode.js",
    "typecheck": "npm run typecheck -ws --if-present",
    "create-renderer": "cd packages && node ./integrate-renderer/create-renderer.js",
    "integrate-renderer": "npm start --workspace @app/integrate-renderer",
    "init": "npm run create-renderer && npm run integrate-renderer && npm install"
  },
  "devDependencies": {
    "@npmcli/map-workspaces": "6.0.0",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "create-vite": "9.1.1",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "glob": "13.0.6",
    "playwright": "^1.61.1"
  },
  "dependencies": {
    "@app/main": "*"
  }
}
